{% extends 'base.html.twig' %}

{% if sendNotification %}
    {% set active = 'async-notif' %}
{% else %}
    {% set active = 'async-no-notif' %}
{% endif %}

{% set importId = app.request.query.get('importId') %}

{% block title %}{{ sendNotification ? 'Async, with feedback' : 'Async, no feedback' }}{% endblock %}

{% block body %}
    <div class="text-center py-5">
        <h1 class="display-5 fw-bold">{{ sendNotification ? 'Async, with feedback' : 'Async, no feedback' }}</h1>
        <p class="lead col-lg-8 mx-auto text-body-secondary">
            {% if sendNotification %}
                Same as async without feedback, but the worker publishes its progress on
                Mercure, and the page is updated in real time thanks to Turbo streams.
            {% else %}
                The import is dispatched to a background worker. The response is
                instant, but you have no clue about the progress.
            {% endif %}
        </p>
    </div>

    {{ form(form) }}

    {% if sendNotification and importId %}
        <div class="col-12 mt-4" id="status">
            {{ _self.status(0, 'The import is going to start') }}
        </div>

        <div {{ turbo_stream_listen('csv:' ~ importId) }}></div>
    {% endif %}
{% endblock %}

{% block status %}
    <turbo-stream action="update" target="status" method="morph" >
        <template>
            {{ _self.status(percent, catch_phrase) }}
        </template>
    </turbo-stream>
{% endblock %}

{% macro status(percent, catch_phrase) %}
    <h2>Progress</h2>

    {% if percent < 25 %}
        {% set bg = 'bg-danger' %}
    {% elseif percent < 50 %}
        {% set bg = 'bg-warning' %}
    {% elseif percent < 75 %}
        {% set bg = 'bg-info' %}
    {% else %}
        {% set bg = 'bg-success' %}
    {% endif %}

    <div class="progress" role="progressbar progress-bar-animated" aria-label="Success example" aria-valuenow="{{ percent }}" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar {{ bg }}" style="width: {{ percent }}%"></div>
    </div>

    <div>
        {{ catch_phrase }}
    </div>
{% endmacro %}
