<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>
            {% block title 'Async with Messenger & Mercure' %}
        </title>
        {% set description = 'Upload a CSV and compare a synchronous import, an async one, and real-time progress pushed with Mercure.' %}
        <meta name="description" content="{{ description }}">
        <meta name="theme-color" content="#050e16">
        <meta property="og:description" content="{{ description }}">
        <meta property="og:image" content="{{ absolute_url(asset('images/social-preview.png')) }}">
        <meta property="og:image:alt" content="Long imports, live progress: a CSV goes from the browser to a Messenger worker, which streams its progress back through the Mercure hub.">
        <meta property="og:image:height" content="630">
        <meta property="og:image:type" content="image/png">
        <meta property="og:image:width" content="1200">
        <meta property="og:site_name" content="Async with Messenger &amp; Mercure">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ absolute_url(app.request.pathInfo) }}">
        <meta name="twitter:card" content="summary_large_image">
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/logo.svg') }}">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {{ include('_navbar.html.twig') }}

        {% block band %}{% endblock %}

        <main class="container-xl py-4 py-lg-5">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="mm-footer">
            <div class="container-xl py-4 d-flex flex-wrap gap-3 justify-content-between">
                <span>A demo of Symfony Messenger and Mercure. Theme inspired by <a href="https://mercure.rocks" target="_blank" rel="noopener">mercure.rocks</a>.</span>
                <span>
                    <a href="https://github.com/lyrixx/async-messenger-mercure" target="_blank" rel="noopener">Source code on GitHub</a>
                    · <a href="https://s.lyrixx.info/async" target="_blank" rel="noopener">The slides</a>
                </span>
            </div>
        </footer>
    </body>
</html>
